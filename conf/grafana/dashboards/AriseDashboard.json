    {
      "id": 17,
      "type": "stat",
      "title": "Time at RULA >= 5",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cratedb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cratedb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * sum(CASE WHEN rula_full >= 5 THEN 1 ELSE 0 END) / NULLIF(count(rula_full), 0) AS \"Time at RULA >= 5\"\nFROM etergodata\nWHERE $__timeFilter(time_index) AND entity_id = '$body' AND rula_full IS NOT NULL",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Share of the samples in the selected time range with RULA 5 or higher (the default warning threshold of ergo_alert)."
    },
