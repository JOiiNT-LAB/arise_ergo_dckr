        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cratedb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_index AS \"time\", rula_full AS \"RULA\"\nFROM etergodata\nWHERE $__timeFilter(time_index) AND entity_id = '$body'\nORDER BY time_index",
