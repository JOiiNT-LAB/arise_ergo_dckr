<?xml version="1.0"?>
<package format="3">
  <name>hri_ergonomics_msgs</name>
  <version>0.1.0</version>
  <description>
    Ergonomic assessment interfaces extending ROS4HRI (REP-155): joint angles,
    RULA/REBA scores, alerts and advice, published per body under
    /humans/bodies/&lt;body_id&gt;/.
  </description>
  <maintainer email="mario.corsanici@intellimech.it">JOiiNT Lab</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
